# Required
MATRIX_HOMESERVER=https://matrix.example.org

# Password login: the account's user ID or localpart. The password itself is
# read from ./matrix_password.txt (compose secret), never from this file:
# Compose would expand any `$` in it.
MATRIX_USER=archive

# Your IDs, shown as "me": the archive account and your own WhatsApp puppet.
MCP_MATRIX_RO_ME=@archive:example.org,@whatsapp_84xxxxxxxxx:example.org

# Owner of ./state (`id -u` and `id -g`); the containers run as this user.
PUID=1000
PGID=1000

# Optional (defaults shown)
MCP_MATRIX_RO_TZ=Asia/Ho_Chi_Minh
# MCP_MATRIX_RO_NETWORKS=whatsapp=^@whatsapp_,telegram=^@telegram_,signal=^@signal_
# MCP_MATRIX_RO_EXCLUDE=
# MCP_MATRIX_RO_EXCLUDE_BOTS=^@(whatsapp|telegram|signal)bot:
# MCP_MATRIX_RO_MAX_BODY=500
# MCP_MATRIX_RO_HTTP_TIMEOUT=20s
MCP_MATRIX_RO_LOG=warn

# HTTP mode: the compose file reads the bearer token from ./mcp_http_token.txt.
# Outside compose, set MCP_MATRIX_RO_HTTP_TOKEN or MCP_MATRIX_RO_HTTP_TOKEN_FILE.
