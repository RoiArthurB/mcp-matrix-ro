# Required
MATRIX_HOMESERVER=https://matrix.example.org
# The token is read from ./matrix_token.txt (compose secret), not from here.

# Your IDs, shown as "me": the archive account and your own WhatsApp puppet.
MXREAD_ME=@archive:example.org,@whatsapp_84xxxxxxxxx:example.org

# Optional (defaults shown)
MXREAD_TZ=Asia/Ho_Chi_Minh
# MXREAD_NETWORKS=whatsapp=^@whatsapp_,telegram=^@telegram_,signal=^@signal_
# MXREAD_EXCLUDE=
# MXREAD_EXCLUDE_BOTS=^@(whatsapp|telegram|signal)bot:
# MXREAD_MAX_BODY=500
# MXREAD_HTTP_TIMEOUT=20s
MXREAD_LOG=warn

# Password login instead of a token: remove the matrix_token secret from the
# compose file and set these (a password file can be mounted as a secret too).
# MATRIX_USER=archive
# MATRIX_PASSWORD_FILE=/run/secrets/matrix_password
